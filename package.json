{
  "name": "agent-review-notes",
  "displayName": "Agent Review Notes",
  "description": "Read a pull request with your AI agent: ordered explanation cards and line-by-line Q&A threads on the diff",
  "version": "0.2.1",
  "publisher": "yoshi47",
  "icon": "media/icon.png",
  "categories": [
    "AI"
  ],
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yoshi47/agent-review-notes"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test out/*.test.js out/bin/*.test.js",
    "test:vscode": "npm run compile && node out/test/run.js",
    "changeset:version": "changeset version && npm install --package-lock-only"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Agent Review Notes",
      "properties": {
        "reviewNotes.openInDiff": {
          "type": "boolean",
          "default": true,
          "description": "Open the Source Control diff when jumping to a thread"
        },
        "reviewNotes.notifyDelaySeconds": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "description": "Seconds of quiet after AI writes before notifying"
        }
      }
    },
    "commands": [
      {
        "command": "reviewNotes.create",
        "title": "Comment",
        "category": "Agent Review Notes"
      },
      {
        "command": "reviewNotes.reply",
        "title": "Reply",
        "category": "Agent Review Notes"
      },
      {
        "command": "reviewNotes.resolve",
        "title": "Resolve",
        "category": "Agent Review Notes",
        "icon": "$(check)"
      },
      {
        "command": "reviewNotes.reopen",
        "title": "Reopen",
        "category": "Agent Review Notes",
        "icon": "$(debug-restart)"
      },
      {
        "command": "reviewNotes.markRead",
        "title": "Mark as Read",
        "category": "Agent Review Notes",
        "icon": "$(eye)"
      },
      {
        "command": "reviewNotes.markUnread",
        "title": "Mark as Unread",
        "category": "Agent Review Notes",
        "icon": "$(eye-closed)"
      },
      {
        "command": "reviewNotes.nextCard",
        "title": "Next Card",
        "category": "Agent Review Notes"
      },
      {
        "command": "reviewNotes.prevCard",
        "title": "Previous Card",
        "category": "Agent Review Notes"
      },
      {
        "command": "reviewNotes.nextUnread",
        "title": "Next Unread Card",
        "category": "Agent Review Notes"
      },
      {
        "command": "reviewNotes.hideRead",
        "title": "Hide Read Cards",
        "category": "Agent Review Notes",
        "icon": "$(filter)"
      },
      {
        "command": "reviewNotes.showRead",
        "title": "Show Read Cards",
        "category": "Agent Review Notes",
        "icon": "$(filter-filled)"
      },
      {
        "command": "reviewNotes.revealCard",
        "title": "Open Card",
        "category": "Agent Review Notes"
      },
      {
        "command": "reviewNotes.copyCliCommand",
        "title": "Copy CLI Command",
        "category": "Agent Review Notes"
      },
      {
        "command": "reviewNotes.archive",
        "title": "Archive Review",
        "category": "Agent Review Notes"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "reviewNotes.create",
          "when": "false"
        },
        {
          "command": "reviewNotes.reply",
          "when": "false"
        },
        {
          "command": "reviewNotes.resolve",
          "when": "false"
        },
        {
          "command": "reviewNotes.reopen",
          "when": "false"
        },
        {
          "command": "reviewNotes.markRead",
          "when": "false"
        },
        {
          "command": "reviewNotes.markUnread",
          "when": "false"
        },
        {
          "command": "reviewNotes.revealCard",
          "when": "false"
        },
        {
          "command": "reviewNotes.hideRead",
          "when": "false"
        },
        {
          "command": "reviewNotes.showRead",
          "when": "false"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "reviewNotes.create",
          "group": "inline",
          "when": "commentController == review-notes && commentThreadIsEmpty"
        },
        {
          "command": "reviewNotes.reply",
          "group": "inline",
          "when": "commentController == review-notes && !commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "reviewNotes.markRead",
          "group": "inline@1",
          "when": "commentController == review-notes && commentThread =~ /-card-unread$/"
        },
        {
          "command": "reviewNotes.markUnread",
          "group": "inline@1",
          "when": "commentController == review-notes && commentThread =~ /-card-read$/"
        },
        {
          "command": "reviewNotes.resolve",
          "group": "inline@2",
          "when": "commentController == review-notes && commentThread =~ /^unresolved/"
        },
        {
          "command": "reviewNotes.reopen",
          "group": "inline@2",
          "when": "commentController == review-notes && commentThread =~ /^resolved/"
        }
      ],
      "view/title": [
        {
          "command": "reviewNotes.hideRead",
          "group": "navigation",
          "when": "view == reviewNotes.cards && !reviewNotes.hidingRead"
        },
        {
          "command": "reviewNotes.showRead",
          "group": "navigation",
          "when": "view == reviewNotes.cards && reviewNotes.hidingRead"
        }
      ]
    },
    "views": {
      "scm": [
        {
          "id": "reviewNotes.cards",
          "name": "Agent Review Notes"
        }
      ]
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.80.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^7.0.2"
  }
}
